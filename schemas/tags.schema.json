{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Elsa Blog Topics",
  "description": "Choose one to three approved topics. See CONTRIBUTING.md before proposing another topic.",
  "type": "array",
  "minItems": 1,
  "maxItems": 3,
  "uniqueItems": true,
  "items": {
    "type": "string",
    "enum": [
      "architecture",
      "devjournal",
      "workflow-authoring",
      "workflow-runtime",
      "extensibility",
      "persistence",
      "security",
      "operations",
      "ai",
      "studio"
    ]
  }
}
